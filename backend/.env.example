# 이 파일은 "사용법 예시" 문서일 뿐이다. Spring Boot는 .env 파일을 자동으로 읽지 않는다.
# 아래 값을 실제 셸 환경변수로 설정하거나, 실행 시 명령행 인자로 전달해야 한다.

# 원본 엑셀 파일의 절대 경로 (개인정보 포함 파일이므로 저장소 안에 두지 않고 외부 경로를 참조한다)
FESTIVAL_EXCEL_PATH=C:/Users/yourname/Downloads/2026년 지역축제 개최 계획 현황(공개용).xlsx

# --- PowerShell에서 실제로 설정하는 방법 ---
# $env:FESTIVAL_EXCEL_PATH = "C:/Users/yourname/Downloads/2026년 지역축제 개최 계획 현황(공개용).xlsx"
# cd backend
# ./mvnw.cmd spring-boot:run "-Dspring-boot.run.arguments=--import.run=true"

# --- 환경변수 없이 인자로 바로 전달하는 방법 ---
# ./mvnw.cmd spring-boot:run "-Dspring-boot.run.arguments=--import.run=true --festival.excel.path=C:/Users/yourname/Downloads/2026년 지역축제 개최 계획 현황(공개용).xlsx"