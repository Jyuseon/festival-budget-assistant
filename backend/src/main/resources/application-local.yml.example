# application-local.yml 템플릿 - 실제 값으로 채운 뒤 파일명을 application-local.yml 로 저장하세요.
# application-local.yml 은 .gitignore 에 등록되어 있어 git에 커밋되지 않습니다.

spring:
  datasource:
    url: jdbc:mysql://localhost:3306/festival_budget?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Seoul
    username: root
    password: "CHANGE_ME"
    driver-class-name: com.mysql.cj.jdbc.Driver

  jpa:
    hibernate:
      ddl-auto: update
    show-sql: true
    properties:
      hibernate:
        format_sql: true
        default_batch_fetch_size: 100
    open-in-view: false

logging:
  level:
    com.festival.budgetassist: DEBUG
    org.hibernate.SQL: DEBUG

# 로컬 개발 환경에서만 관리자 데이터 검증 API(/api/v1/admin/datasets/**)와
# 예산 추정 계산 상세(calculationTrace)를 켠다.
festival:
  admin-ui:
    enabled: true
  calculation-trace:
    enabled: true